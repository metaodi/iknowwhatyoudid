# iknowwhatyoudid — credentials
#
# Copy to `credentials.toml` beside your config.toml and restrict it to your account.
# This file is the ONLY place a secret belongs. The tool reads it to answer one
# question — is this credential present? — and never prints or stores its value.

[credential.REPLACE-credential-name]
# The shape of an entry is decided by feature 0004, which performs the first real
# authorization flow. Today only the presence of the entry is checked.
token = "REPLACE-with-your-token"
